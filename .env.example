# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore
# y nunca debe llegar al repositorio.

# Dirección pública de tu API de Supabase (Kong).
VITE_SUPABASE_URL=https://api.finanzas.ejemplo.com

# Llave anónima. Es pública por diseño: va en el navegador y no da acceso a
# nada por sí sola, porque el aislamiento lo impone la base de datos con RLS.
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Lo de abajo vive SOLO en el servidor. Nada con prefijo VITE_ es secreto: Vite
# lo incrusta en el bundle que descarga cualquiera.
# ─────────────────────────────────────────────────────────────────────────────

# Ignora el aislamiento entre usuarios por completo. Si se filtra, quien la
# tenga lee y escribe los datos de todas las cuentas.
# SUPABASE_SERVICE_ROLE_KEY=

# POSTGRES_PASSWORD=
# JWT_SECRET=

# Correo para verificar cuentas y recuperar contraseñas.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SENDER_NAME=Finanzas GZ

# Notificaciones push (fase 5). La privada nunca sale del servidor.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Usuarios de prueba
#
# Cuentas para entrar a la app sin pasar por el registro y la verificación de
# correo cada vez. Son credenciales de juguete: no las uses en producción ni
# repitas estas contraseñas en una cuenta real.
#
# OJO: por ahora esto es documentación, no siembra automática — no hay nada en
# el código que lea estas variables. Para que las cuentas existan de verdad hay
# que insertarlas en Postgres con el comando del final del bloque.
#
# La contraseña cumple lo que exige el registro: 8+ caracteres, con mayúscula,
# minúscula y número.
# ─────────────────────────────────────────────────────────────────────────────

# Cuenta principal de pruebas.
TEST_USER_EMAIL=test@finanzasgz.com.mx
TEST_USER_PASSWORD=Prueba1234!
TEST_USER_NOMBRE=Usuario de Prueba

# Segunda cuenta. Sirve para comprobar que un usuario no ve los datos del otro:
# el aislamiento aquí lo aplica la capa de servicio con el userId del JWT, no la
# base de datos, así que conviene probarlo con dos sesiones de verdad.
TEST_USER2_EMAIL=test2@finanzasgz.com.mx
TEST_USER2_PASSWORD=Prueba1234!
TEST_USER2_NOMBRE=Segundo de Prueba

# Cuenta con rol admin (la columna `rol` acepta 'usuario' o 'admin').
TEST_ADMIN_EMAIL=admin@finanzasgz.com.mx
TEST_ADMIN_PASSWORD=Prueba1234!
TEST_ADMIN_NOMBRE=Admin de Prueba

# Crearlas en tu Postgres. `email_verificado` va en true para saltarse el correo,
# y el trigger `preparar_usuario` siembra solo los ajustes y las 17 categorías.
# `crypt`/`gen_salt` salen de pgcrypto, que el esquema ya instala, y producen un
# hash bcrypt que el backend valida igual que el suyo:
#
#   insert into public.users
#     (email, password_hash, display_name, email_verificado, email_verificado_en, rol)
#   values
#     ('test@finanzasgz.com.mx',  crypt('Prueba1234!', gen_salt('bf', 12)), 'Usuario de Prueba', true, now(), 'usuario'),
#     ('test2@finanzasgz.com.mx', crypt('Prueba1234!', gen_salt('bf', 12)), 'Segundo de Prueba', true, now(), 'usuario'),
#     ('admin@finanzasgz.com.mx', crypt('Prueba1234!', gen_salt('bf', 12)), 'Admin de Prueba',   true, now(), 'admin')
#   on conflict (email) do nothing;
