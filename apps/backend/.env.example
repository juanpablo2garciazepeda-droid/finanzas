# Finanzas GZ — backend
# Copia este archivo a .env (NO se commitea) y rellena los valores.

# Puerto que sirve la API. Dentro del contenedor se respeta el de Dokploy.
PORT=3000

# Postgres. En Dokploy, DATABASE_HOST apunta al nombre del servicio
# (típicamente algo como "finanzas-postgres") en la red dokploy-network.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=finanzas
DATABASE_PASSWORD=changeme
DATABASE_NAME=finanzas

# JWT. Usa una cadena larga y aleatoria en producción.
# Ejemplo: openssl rand -hex 48
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# CORS: lista separada por comas. Por defecto solo el frontend oficial.
CORS_ORIGINS=https://finanzasgz.com.mx
